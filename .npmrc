[phases.setup]
nixPkgs = ["nodejs_20"]

[phases.install]
cmds = [
  "rm -rf /tmp/.npm /root/.npm /www-data-home/.npm 2>/dev/null || true",
  "mkdir -p /tmp/npmcache",
  "npm config set cache /tmp/npmcache --global",
  "npm install --omit=dev --no-audit --no-fund --loglevel=error"
]

[start]
cmd = "npx n8n start"
